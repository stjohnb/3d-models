    { "name": "corner_radius", "label": "Eased edge radius on posts and rails (mm, 0 = sharp)", "type": "number", "min": 0, "max": 10, "step": 1, "default": 5 },
    { "name": "beam_depth", "label": "Cross beam, divider and far side rail depth (mm)", "type": "number", "min": 90, "max": 200, "step": 5, "default": 145 },
